# Set these variables in the process environment; this file is a reference template.
AUTOBUILD_ENVIRONMENT=development
AUTOBUILD_API_KEY=replace-with-a-long-random-secret
AUTOBUILD_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Optional: defaults to backend/data
# AUTOBUILD_DATA_DIR=C:/absolute/path/to/autobuild-data
# Optional Codex advisor settings. By default Corsair locates codex.exe/codex on PATH.
# AUTOBUILD_CODEX_EXECUTABLE=C:/absolute/path/to/codex.exe
# AUTOBUILD_CODEX_MODEL=gpt-5.4-mini
# AUTOBUILD_CODEX_TIMEOUT_SECONDS=120
